# These are examples. Set environment variables in your shell or service configuration.
# The application does not automatically read .env files.
KANBAN_HOST=127.0.0.1
KANBAN_PORT=8000
# Use an absolute path on a persistent local disk/volume:
# KANBAN_DATABASE=C:/Users/Jonas/vigo/kanban/data/kanban.sqlite3
KANBAN_MAX_FILE_MB=20
KANBAN_SESSION_HOURS=12
# Enable for HTTPS deployments:
KANBAN_COOKIE_SECURE=0
# Required behind an HTTPS reverse proxy; omit for direct localhost development:
# KANBAN_PUBLIC_ORIGIN=https://kanban.example.com
# Private GitHub repository: fine-grained token with Contents: read, limited to this repository.
# Set securely in the server environment; never commit the real credential.
# KANBAN_GITHUB_TOKEN=
